# DirSets, named sets of directories to chart, read by
# `dirhistory-generate --dirsets FILE`.
# Only the trees named here are generated, so the file names at least one.
# Both views draw from the dirsets: Stack splits the chosen dirset's
# directories (and what is stored below them), Trends shows a card for each.
#
# `budget` is the most directories a tree's data file stores (all its dirsets
# share one file). It is required: here at the top for every tree, or in a
# tree's own [tree."/fs/path"] section, which overrides it. A tree whose dirsets
# cover more is stored breadth-first: every level from the tree root whole
# while it fits, then as many whole directories' subdirectories of the next
# level as fit, in path order, nothing deeper. The run warns, and the page
# marks a directory whose subdirectories were left out with *. Size it for
# the browser: the page needs about 3 KB of memory per stored directory
# (see docs/design.md, "Large budgets make large files").
#
# Sections are named by the tree's root path (its fs_path) and the dirset's
# name. The page lists a tree's dirsets in its DirSet menu, in this order,
# after the implicit dirset "Top level": every directory directly under the
# tree root, depth 0. A dirset of that name here replaces it (still first),
# e.g. to store the top-level directories 2 levels deep.
#
# Tree roots are assumed to be unique: two trees with the same root (on
# different clusters or filesystems) cannot be told apart, and a section
# naming them is an error. So is a section naming no tree. A tree whose root
# is not valid UTF-8 cannot be named.
#
# `dirs` is a non-empty list of groups. A group's `match` lists paths
# relative to the tree root. Their components may hold shell wildcards
# (*, ?, [...]), matched one component at a time: * never crosses /. There
# is no **. "." is the tree root itself. A pattern matches only directories
# within the tree's max depth.
#
# `depth` (required) is how many levels below each matched directory are
# stored as well: 0 is the directory only. A directory covered by several
# groups, in one dirset or several, is stored to the largest depth, and the
# page can drill that far in every dirset, within the tree's budget.
#
# Keep a dirset's directories disjoint: a directory and one of its
# subdirectories in the same dirset are both drawn, so the subdirectory
# counts twice. Put an enclosing directory, such as ".", in a dirset of its
# own.

budget = 100000

[tree."/data/projects"]
budget = 200000                            # this tree's own, instead of the one above

[tree."/data/projects".dirset."Projects"]
dirs = [
  { match = ["*"], depth = 1 },            # every project (new ones too), 1 level down
]

[tree."/data/projects".dirset."Whole tree"]
dirs = [
  { match = ["."], depth = 1 },            # the tree root, as one band
]

[tree."/data/projects".dirset."Raw data"]
dirs = [
  { match = ["*/raw"], depth = 0 },        # raw/ of every project
  { match = ["alpha/archive"], depth = 3 },  # one directory, 3 levels down
]

[tree."/data/scratch".dirset."Users a-m"]
dirs = [
  { match = ["[a-m]*"], depth = 0 },       # some of the tree's subdirectories
]
