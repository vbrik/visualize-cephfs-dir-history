# Regenerates the website's data files; started by dirhistory.timer.
# Adjust paths and the database URL. The password goes in the PGPASSFILE,
# not in TRACKDIR_DB. The dirhistory user, the PGPASSFILE (mode 600) and the
# ReadWritePaths directory must exist first; see README.md, "Deploy".
[Unit]
Description=Regenerate CephFS directory history data files
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dirhistory
Environment=TRACKDIR_DB=postgresql://trackdir@db.example.org/trackdir
Environment=PGPASSFILE=/etc/dirhistory/pgpass
ExecStart=/opt/dirhistory/venv/bin/dirhistory-generate --out /opt/dirhistory/web/data
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/dirhistory/web/data
